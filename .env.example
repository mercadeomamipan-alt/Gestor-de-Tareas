# Copia este archivo como .env.local para probar en tu computador.
# En Vercel, estas mismas variables van en Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo la usa el resumen diario. Nunca la compartas ni la pongas en el código.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail que envía los avisos y su contraseña de aplicación (16 letras, sin espacios)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Dirección pública de la app, sin "/" al final (ej. https://gestor-de-tareas.vercel.app)
APP_URL=

# Texto largo y aleatorio. Vercel lo usa para proteger el resumen diario.
CRON_SECRET=

# Opcional, solo para pruebas locales con un servidor de correo de desarrollo (no lo pongas en Vercel)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
